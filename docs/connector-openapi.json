{
  "openapi": "3.1.0",
  "info": {
    "title": "Cacaduu Cloud API for the POS Sync Agent",
    "version": "1.0.0",
    "description": "See docs/CONNECTOR_CLOUD_API.md. Every request carries the header Cacaduu-Agent-Version. x-cacaduu-phase: A = live (update 50); B = live (update 52); C answers 501 not_available until its update is deployed."
  },
  "servers": [
    {
      "url": "https://{projectRef}.supabase.co/functions/v1/connector",
      "variables": {
        "projectRef": {
          "default": "your-project-ref"
        }
      }
    }
  ],
  "security": [
    {
      "deviceToken": []
    }
  ],
  "paths": {
    "/v1/pair": {
      "post": {
        "operationId": "pair",
        "summary": "Pair this computer with one shop using a pairing code",
        "x-cacaduu-phase": "A",
        "responses": {
          "201": {
            "description": "Paired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "pairing_locked (Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "426": {
            "description": "update_required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "server_error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairRequest"
              }
            }
          }
        },
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentVersion"
          }
        ]
      }
    },
