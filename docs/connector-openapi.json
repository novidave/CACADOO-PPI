              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "Phase not switched on yet (not_available)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentVersion"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandResult"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cdt_<43 base64url characters>"
      }
    },
    "parameters": {
      "AgentVersion": {
        "name": "Cacaduu-Agent-Version",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "example": "1.4.2"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "bad_request",
              "agent_version_required",
              "invalid_code",
              "unauthorized",
              "not_found",
              "method_not_allowed",
              "stale",
              "send_full_snapshot",
              "already_claimed",
              "snapshot_not_applied",
              "too_large",
              "clock_ahead",
              "update_required",
              "pairing_locked",
              "rate_limited",
              "server_error",
              "not_available"
            ]
          },
          "message": {
            "type": "string"
          },
          "retry_after": {
            "type": "integer"
          },
          "min_agent_version": {
            "type": "string"
          }
        }
      },
      "PairRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "8 letters from ABCDEFGHJKMNPQRSTUVWXYZ23456789; a dash, spaces and case are ignored",
            "example": "K7QM-4WXP"
          },
          "device_name": {
            "type": "string",
            "maxLength": 80
          },
          "agent_version": {
            "type": "string"
          },
          "os": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "PairResponse": {
        "type": "object",
        "required": [
          "device_id",
          "device_token",
          "shop",
          "api_base_url",
          "next_poll_seconds",
          "min_agent_version",
          "server_time"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "device_token": {
            "type": "string",
            "pattern": "^cdt_[A-Za-z0-9_-]{43}$",
            "description": "Shown once; store it in the OS secure storage"
          },
          "shop": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "next_poll_seconds": {
            "type": "integer",
            "minimum": 15
          },
          "min_agent_version": {
            "type": "string"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HeartbeatRequest": {
        "type": "object",
        "properties": {
          "agent_version": {
            "type": "string"
          },
          "os": {
            "type": "string",
            "maxLength": 80
          },
          "source_label": {
            "type": "string",
            "maxLength": 80,
            "example": "POHODA XML"
          },
          "last_read": {
            "type": "object",
            "properties": {
              "result": {
                "type": "string",
                "enum": [
                  "ok",
                  "unchanged",
                  "error",
                  "none"
                ]
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500,
                "description": "Plain text without passwords"
              }
            }
          }
        }
      },
      "HeartbeatResponse": {
        "type": "object",
        "required": [
          "shop",
          "commands",
          "api_base_url",
          "next_poll_seconds",
          "min_agent_version",
          "server_time"
        ],
        "properties": {
          "shop": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Command"
            }
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "next_poll_seconds": {
            "type": "integer",
            "minimum": 15
          },
          "min_agent_version": {
            "type": "string"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": [
          "shop",
          "device",
          "state"
        ],
        "properties": {
          "shop": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          },
          "device": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "paired_at": {
                "type": "string",
                "format": "date-time"
              },
              "last_seen_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "error",
              "never_synced",
              "syncing"
            ]
          },
          "last_sync": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "next_poll_seconds": {
            "type": "integer",
            "minimum": 15
          },
          "min_agent_version": {
            "type": "string"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RotateResponse": {
        "type": "object",
        "required": [
          "device_token",
          "old_token_valid_until"
        ],
        "properties": {
          "device_token": {
            "type": "string",
            "pattern": "^cdt_[A-Za-z0-9_-]{43}$"
          },
          "old_token_valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "api_base_url": {
            "type": "string",
            "format": "uri"
          },
          "next_poll_seconds": {
            "type": "integer",
            "minimum": 15
          },
          "min_agent_version": {
            "type": "string"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "source_code",
          "name",
          "price",
          "currency",
          "quantity"
        ],
        "additionalProperties": true,
        "description": "Fields not listed here are dropped and never stored",
        "properties": {
          "source_code": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 300
          },
          "ean": {
            "type": "string",
            "maxLength": 32
          },
          "brand": {
            "type": "string",
            "maxLength": 120
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "quantity": {
            "type": "number"
          },
          "availability_status": {
            "type": "string",
            "maxLength": 40
          },
          "warehouse": {
            "type": "string",
            "maxLength": 80
          },
          "source_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InventorySnapshot": {
        "type": "object",
        "description": "The uncompressed JSON that is gzipped and uploaded to upload_url",
        "required": [
          "format",
          "snapshot_id",
          "source_id",
          "source_time",
          "products"
        ],
        "properties": {
          "format": {
            "const": "cacaduu.inventory.v1"
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "maxLength": 80
          },
          "source_time": {
            "type": "string",
            "format": "date-time"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "SnapshotAnnounce": {
        "type": "object",
        "required": [
          "snapshot_id",
          "source_id",
          "source_time",
          "complete",
          "product_count",
          "content_hash"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_id": {
            "type": "string",
            "maxLength": 80
          },
          "source_time": {
            "type": "string",
            "format": "date-time"
          },
          "complete": {
            "const": true
          },
          "product_count": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "command_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "SnapshotState": {
        "type": "object",
        "required": [
          "snapshot_id",
          "state"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "awaiting_upload",
              "processing",
              "applied",
              "held",
              "test_ok",
              "rejected",
              "expired"
            ]
          },
          "upload_url": {
            "type": "string",
            "format": "uri",
            "description": "Signed Supabase Storage upload URL (15 minutes): PUT the gzipped JSON, Content-Type application/gzip, x-upsert true. No device token."
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "description": "For held: empty or shrinking."
          },
          "error": {
            "type": "string",
            "description": "For rejected: incomplete, upload_expired, too_large, bad_gzip, hash_mismatch, bad_format, count_mismatch, invalid_rows, stale, discarded_by_owner."
          },
          "message": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "products": {
                "type": "integer"
              },
              "imported": {
                "type": "integer"
              },
              "zeroed": {
                "type": "integer"
              },
              "skipped": {
                "type": "integer"
              }
            }
          },
          "max_bytes": {
            "type": "integer",
            "description": "Largest gzipped upload accepted (only with upload_url)."
          }
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "required": [
          "content_hash",
          "source_time"
        ],
        "properties": {
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_time": {
            "type": "string",
            "format": "date-time"
          },
          "command_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ConfirmResponse": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "confirmed",
              "test_ok"
            ],
            "description": "test_ok = the shop's stock source is not the POS agent; nothing changed."
          }
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "id",
          "type",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "sync_inventory",
              "ping"
            ],
            "description": "Agents ignore any other type"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "claimed",
              "running",
              "completed",
              "failed",
              "expired"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "lease_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "attempt": {
            "type": "integer"
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "running",
              "failed",
              "completed"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "snapshot_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
