    "/v1/inventory/snapshots/{id}/complete": {
      "post": {
        "operationId": "completeSnapshot",
        "summary": "The upload is done: check and apply (or hold) the snapshot",
        "x-cacaduu-phase": "B",
        "responses": {
          "200": {
            "description": "Applied, held, test_ok or rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotState"
                }
              }
            }
          },
          "202": {
            "description": "Processing; ask GET /v1/inventory/snapshots/{id}",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotState"
                }
              }
            }
          },
          "404": {
            "description": "not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or missing Cacaduu-Agent-Version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "426": {
            "description": "Agent too old (update_required)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, wrong or revoked device token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "not_uploaded (PUT the file first), stale (a newer snapshot was applied) or not_processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "too_large (the snapshot is rejected)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/AgentVersion"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
