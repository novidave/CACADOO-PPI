# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "anon public" (or the "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your public site address, used for canonical links and the sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow key (public by design: every host serves it as /<key>.txt). 32 letters and digits; the same value is the
# Supabase secret INDEXNOW_KEY of the stock-pull function. Empty = no key file (and no IndexNow).
INDEXNOW_KEY=

# NEVER put the service_role / secret key here or in Vercel.
