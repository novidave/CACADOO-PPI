# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → "anon public" (or the "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your public site address, used for canonical links and the sitemap (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEVER put the service_role / secret key here or in Vercel.
