{
  "name": "ppi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "bash supabase/tests/run.sh",
    "check:functions": "cd supabase/functions && (deno check --config deno.json */index.ts || npx -y deno check --config deno.json */index.ts)",
    "test:functions": "cd supabase/functions && (PPI_STOCK_PULL_TEST=1 PPI_FUNCTION_TEST=1 deno test --config deno.json --allow-env . || PPI_STOCK_PULL_TEST=1 PPI_FUNCTION_TEST=1 npx -y deno test --config deno.json --allow-env .)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
