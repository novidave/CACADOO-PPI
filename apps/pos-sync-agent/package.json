{
  "name": "cacaduu-pos-sync-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local connector for complete reported stock exports",
  "author": "Cacaduu",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win nsis",
    "build:win-portable": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.3",
    "read-excel-file": "^6.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.cacaduu.pos-sync-agent",
    "productName": "Cacaduu Connector",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": "dmg"
    }
  }
}
